# Shared Git identity and commit signing. Machine-specific settings such as
# credential helpers stay in ~/.gitconfig, which Git reads after this file.

[user]
	name = Sammykins
	email = 26049947+thesammykins@users.noreply.github.com
	# Refuse to commit without an explicit email instead of guessing one from
	# the hostname (which produced sammykins@<tailnet host> commits before).
	useConfigOnly = true
	# Public half of the "GitHub Signing" key in 1Password.
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH3qM4rE37D2jHWOl3kwwatgsM7H8TCTDrXaZtdA4zlP

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[init]
	defaultBranch = main

# Work is trunk-based: pushes go straight to main, so pulls rebase local
# commits onto the remote instead of creating merge commits.
[pull]
	rebase = true

[rebase]
	autoStash = true

[fetch]
	prune = true

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram

# git-delta is in the core Brewfile, so every Mac gets it.
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
