# Shared Git identity and defaults. Machine-specific settings such as
# credential helpers stay in ~/.gitconfig, which Git reads after this file.

[user]
	name = Sammykins
	email = 26049947+thesammykins@users.noreply.github.com
	# Refuse to commit without an explicit email instead of guessing one from
	# the hostname (which produced sammykins@<tailnet host> commits before).
	useConfigOnly = true

[init]
	defaultBranch = main

# Work is trunk-based: pushes go straight to main, so pulls rebase local
# commits onto the remote instead of creating merge commits.
[pull]
	rebase = true

[rebase]
	autoStash = true

[fetch]
	prune = true

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram

# git-delta is in the core Brewfile, so every Mac gets it.
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

# Commit signing goes through the 1Password app, which CI runners don't have.
# The installer links signing.gitconfig only where 1Password's signer exists;
# Git ignores an include whose file is missing, so elsewhere commits are
# simply unsigned instead of failing.
[include]
	path = ~/.config/git/signing.gitconfig
