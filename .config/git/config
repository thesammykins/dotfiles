# Shared Git identity and commit signing. Machine-specific settings such as
# credential helpers stay in ~/.gitconfig, which Git reads after this file.

[user]
	name = Sammykins
	email = 26049947+thesammykins@users.noreply.github.com
	# Refuse to commit without an explicit email instead of guessing one from
	# the hostname (which produced sammykins@<tailnet host> commits before).
	useConfigOnly = true
	# Public half of the "GitHub Signing" key in 1Password.
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH3qM4rE37D2jHWOl3kwwatgsM7H8TCTDrXaZtdA4zlP

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true
