# Developer-machine additions.
# Layers on top of workstation. Install with:
#   scripts/brew-tiers.sh install core workstation dev

tap "anomalyco/tap"
tap "buildkite/buildkite"
tap "cameroncooke/axe"
tap "can1357/tap"
tap "mobile-dev-inc/tap"

brew "actionlint"
brew "age"
brew "aria2"
brew "asc"
brew "cameroncooke/axe/axe"
brew "bats-core"
brew "buildkite/buildkite/bk@3"
brew "buildkite/buildkite/buildkite-agent@3"
brew "carapace"
brew "cmake"
brew "coreutils"
brew "findutils"
brew "gitleaks"
brew "gnu-sed"
brew "gnu-tar"
brew "hunk"
brew "imagemagick"
brew "mobile-dev-inc/tap/maestro"
brew "mise"
brew "ninja"
brew "can1357/tap/omp"
brew "anomalyco/tap/opencode"
brew "pkgconf"
brew "scrcpy"
brew "shellcheck"
brew "shfmt"
brew "tmux"
brew "tree"
brew "uv"
brew "varlock"
brew "watchman"
brew "xcodegen"
brew "xcodes"
brew "yq"

cask "android-commandlinetools"
cask "android-platform-tools"
cask "codex"
cask "cuadriver"
cask "font-jetbrains-mono-nerd-font"
cask "google-chrome"
cask "openpencil"
cask "openusage"
cask "orbstack"
cask "temurin"

mas "TestFlight", id: 899247664
