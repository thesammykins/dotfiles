# Developer-machine additions.
# Developer tools and agent CLIs. Install with:
#   scripts/brew-tiers.sh install core workstation dev

tap "anomalyco/tap"
tap "buildkite/buildkite"
tap "cameroncooke/axe"
tap "can1357/tap"

brew "aria2"
brew "asc"
brew "cameroncooke/axe/axe"
brew "bats-core"
brew "buildkite/buildkite/bk@3"
brew "carapace"
brew "coreutils"
brew "findutils"
brew "gnu-sed"
brew "gnu-tar"
brew "imagemagick"
brew "mise"
brew "can1357/tap/omp"
brew "anomalyco/tap/opencode"
brew "pkgconf"
brew "shellcheck"
brew "uv"
brew "varlock"
brew "xcodes"

cask "amp-app"
cask "android-commandlinetools"
cask "android-platform-tools"
cask "claude-code"
cask "codex"
cask "codexbar"
cask "cuadriver"
cask "google-chrome"
cask "opencode-desktop"
cask "openpencil"
cask "orbstack"
cask "temurin"

mas "TestFlight", id: 899247664
