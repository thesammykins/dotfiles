# Developer-machine additions.
# Install with:
#   DOTFILES_INSTALL_DEV=1 ~/Development/dotfiles/scripts/install.sh

tap "anomalyco/tap"
tap "buildkite/buildkite"
tap "cameroncooke/axe"
tap "mobile-dev-inc/tap"

brew "actionlint"
brew "age"
brew "asc"
brew "cameroncooke/axe/axe"
brew "bats-core"
brew "buildkite/buildkite/bk@3"
brew "carapace"
brew "gitleaks"
brew "mobile-dev-inc/tap/maestro"
brew "mise"
brew "anomalyco/tap/opencode"
brew "scrcpy"
brew "shellcheck"
brew "shfmt"
brew "tmux"
brew "tree"
brew "uv"
brew "varlock"
brew "watchman"
brew "xcodegen"
brew "xcodes"
brew "yq"

cask "android-commandlinetools"
cask "android-platform-tools"
cask "codex"
cask "font-jetbrains-mono-nerd-font"
cask "google-chrome"
cask "orbstack"
cask "temurin"

mas "TestFlight", id: 899247664
